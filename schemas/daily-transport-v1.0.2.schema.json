{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lurek-st/weather-stock-china-study/schemas/daily-transport-v1.0.2.schema.json",
  "title": "ChatGPT daily weather-market transport export V1.0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "export_version",
    "run_type",
    "run_id",
    "generated_at",
    "records"
  ],
  "properties": {
    "export_version": {
      "const": "1.0.2"
    },
    "run_type": {
      "enum": [
        "daily_collection",
        "backfill"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/regionRecord"
      }
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "u",
        "t",
        "s"
      ],
      "properties": {
        "v": {
          "type": [
            "number",
            "integer",
            "string",
            "boolean",
            "null"
          ]
        },
        "u": {
          "type": [
            "string",
            "null"
          ]
        },
        "t": {
          "enum": [
            "observed",
            "forecast",
            "estimated",
            "reported",
            "unavailable"
          ]
        },
        "s": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "n": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "publisher",
        "accessed_at",
        "official"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "publisher": {
          "type": "string"
        },
        "accessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "official": {
          "type": "boolean"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "weatherWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "metrics",
        "alert"
      ],
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/metric"
          }
        },
        "alert": {
          "enum": [
            "none",
            "moderate",
            "severe",
            "extreme",
            "unknown"
          ]
        },
        "notes_zh": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "city": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "city_id",
        "weather"
      ],
      "properties": {
        "city_id": {
          "type": "string"
        },
        "weather": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pre_open",
            "trading_session",
            "full_day"
          ],
          "properties": {
            "pre_open": {
              "$ref": "#/$defs/weatherWindow"
            },
            "trading_session": {
              "$ref": "#/$defs/weatherWindow"
            },
            "full_day": {
              "$ref": "#/$defs/weatherWindow"
            }
          }
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "type",
        "calendar_checked",
        "calendar_source_ids",
        "open",
        "close"
      ],
      "properties": {
        "status": {
          "enum": [
            "open",
            "closed_holiday",
            "closed_weekend",
            "early_close",
            "special_session",
            "unexpected_closure",
            "unknown"
          ]
        },
        "type": {
          "enum": [
            "regular",
            "early_close",
            "special",
            "closed",
            "unknown"
          ]
        },
        "calendar_checked": {
          "type": "boolean"
        },
        "calendar_source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "open": {
          "type": [
            "string",
            "null"
          ]
        },
        "close": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_id",
        "city_id",
        "index_name",
        "exchange",
        "currency",
        "primary",
        "session",
        "metrics"
      ],
      "properties": {
        "market_id": {
          "type": "string"
        },
        "city_id": {
          "type": "string"
        },
        "index_name": {
          "type": "string"
        },
        "exchange": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "primary": {
          "type": "boolean"
        },
        "session": {
          "$ref": "#/$defs/session"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/metric"
          }
        },
        "notes_zh": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "regionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region",
        "target_date",
        "collection_mode",
        "lag_days",
        "backfill_reason",
        "cities",
        "markets",
        "sources",
        "quality"
      ],
      "properties": {
        "region": {
          "enum": [
            "asia",
            "europe",
            "us"
          ]
        },
        "target_date": {
          "type": "string",
          "format": "date"
        },
        "collection_mode": {
          "enum": [
            "scheduled_live",
            "backfill",
            "manual_repair"
          ]
        },
        "lag_days": {
          "type": "integer",
          "minimum": 0
        },
        "backfill_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "cities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/city"
          }
        },
        "markets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/market"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "issues"
          ],
          "properties": {
            "status": {
              "enum": [
                "complete",
                "partial",
                "unrecoverable"
              ]
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "summary_zh": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
